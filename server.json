{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.deployangel/deployangel",
  "title": "DeployAngel",
  "description": "Wait for production to clear each deploy, and read the evidence when a release fails.",
  "websiteUrl": "https://www.deployangel.com",
  "repository": {
    "url": "https://github.com/DeployAngel/deployangel-python",
    "source": "github"
  },
  "version": "0.1.19",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "deployangel",
      "version": "0.1.19",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ],
      "environmentVariables": [
        {
          "name": "DEPLOYANGEL_API_TOKEN",
          "description": "A \"CLI & coding agents\" token from your app's Settings in DeployAngel",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ]
}
